---
import "lenis/dist/lenis.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Energy Club",
  description = "Energy Club is a distributed clean energy utility that generates and delivers large-scale renewable energy for entertainment, live music, sports, events, film, broadcast, disaster relief, grid services, construction, EV charging, industrial, mining and other off-grid applications.",
} = Astro.props;

const ogImage = new URL("/images/og.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
    <link rel="manifest" href="/favicons/site.webmanifest" />
    <meta name="theme-color" content="#000000" />

    <link rel="preload" href="/fonts/ModernGothic-Black.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ModernGothic-Medium.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:locale" content="en_CA" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:site_name" content="Energy Club" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="min-h-screen font-sans antialiased">
    <slot />

    <script>
      import "../scripts/smooth-scroll";
      import "../scripts/parallax";
    </script>
  </body>
</html>
