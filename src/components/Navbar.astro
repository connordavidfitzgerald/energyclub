---
import logoSvg from "../assets/EnergyClub_Web.svg?raw";

/**
 * Fixed navbar with the About dropdown: a green panel that wipes down from
 * the top on hovering About, and goes again once the pointer leaves the
 * navbar and panel. Taps and keyboard toggle it too. Contact brings the
 * footer up over the page (Footer.astro runs it).
 *
 * The logo is inlined, drawn in currentColor, so it turns dark with the links
 * while the panel is open.
 */
const logo = logoSvg
    .replaceAll('"white"', '"currentColor"')
    .replace("<svg", '<svg aria-hidden="true" class="h-[clamp(1rem,0.8rem+0.5vw,1.5rem)] w-auto"');

const customers = [
    "Commercial Real Estate",
    "Arenas, Stadiums and Speedways",
    "Live Music and Sports Events",
    "Film Broadcast",
    "Disaster Relief",
    "Grid Services",
    "Construction",
    "EV Charging",
    "Industrial Mining",
];

// Draws in from the left on hover and leaves to the right
const underline =
    "block bg-[linear-gradient(currentColor,currentColor)] bg-size-[0%_0.07em] bg-right-bottom bg-no-repeat pb-[0.1em] duration-500 ease-power3-out group-hover:bg-size-[100%_0.07em] group-hover:bg-left-bottom group-focus-visible:bg-size-[100%_0.07em] group-focus-visible:bg-left-bottom";
---

<!-- data-footer: the footer is showing (the footer's script sets it), and the
     About panel turns olive with green text over it -->
<!-- Starts hidden under the intro, like the sand: the intro's video wipe
     uncovers it (Flywheel.astro runs it, and clears this) -->
<header
    data-nav
    inert
    class="group/nav fixed inset-x-0 top-0 z-1000 text-white"
    style="clip-path: inset(100lvh 0 0 0)"
>
    <!-- 12 columns from lg, as in Figma: 3 + 3, two empty, then 4 -->
    <div
        id="about-panel"
        data-nav-panel
        data-lenis-prevent
        class="invisible absolute inset-x-0 top-0 max-h-svh overflow-y-auto bg-green text-black transition-colors duration-300 group-data-[footer]/nav:bg-olive group-data-[footer]/nav:text-green"
        style="clip-path: inset(0 0 100% 0)"
    >
        <div class="grid gap-x-2.5 gap-y-5 px-4 pt-20 pb-10 text-small leading-[1.2] md:grid-cols-2 md:px-5 lg:grid-cols-12">
            <p data-nav-reveal class="lg:col-span-3">
                Want to swap fossil fuels for clean energy? Or do you just want more energy from the
                grid, but can’t get it? Energy Club solves both issues by generating and delivering
                large-scale renewable energy—no transmission lines required.
            </p>
            <div class="flex flex-col gap-5 lg:col-span-3">
                <p data-nav-reveal>
                    Not only does this enable us to deliver massive, resilient and instantaneous
                    power in complex layouts over long periods of time, but also service new
                    non-utility scale customers including:
                </p>
                <ul data-nav-reveal>
                    {customers.map((customer) => <li>{customer}</li>)}
                </ul>
            </div>
            <div class="flex flex-col gap-[1.2em] tracking-[-0.01em] md:col-span-2 lg:col-span-4 lg:col-start-9">
                <p data-nav-reveal>
                    The company started with a simple vision of eliminating fossil fuels from the live
                    entertainment industry, and has since evolved into a systems-level solution that
                    uses a unique combination of static and mobile clean energy generation and
                    distribution in concert with intelligent, utility-scale technology.
                </p>
                <p data-nav-reveal>
                    By aggregating these “loads,” we are able to provide cost-effective renewable
                    energy - or in some cases, energy where there is no other alternative. With every
                    project, we offer pro bono clean energy to community organizations and independent
                    creatives via <a href="#solarpunks" class="underline">Solarpunks.</a>
                </p>
            </div>
        </div>
    </div>

    <!-- Turns olive over the green footer (the footer's script sets it, on
         the bar itself so it wins over the colour the About panel tweens),
         and green once the olive About panel is open over it -->
    <nav data-nav-bar class="relative flex items-center justify-between px-4 pt-4 transition-colors duration-300 md:px-5 md:pt-5 [[data-footer][data-about-open]_&]:text-green">
        <a href="/" aria-label="Energy Club" set:html={logo} />
        <div class="flex justify-end gap-[clamp(1.25rem,3vw,2.5rem)] text-small tracking-tight">
            <button
                type="button"
                data-nav-about
                aria-expanded="false"
                aria-controls="about-panel"
                class="group cursor-pointer"
            >
                <span class:list={[underline, "transition-[background-size]"]}>About</span>
            </button>
            <!-- Reveals the footer over the page (the footer's script runs it).
                 Rolls over to Close while the footer is showing. -->
            <button
                type="button"
                data-nav-contact
                aria-label="Contact"
                class="group grid cursor-pointer justify-items-end overflow-hidden"
            >
                <span
                    aria-hidden="true"
                    class:list={[underline, "col-start-1 row-start-1 transition-[background-size,translate] group-data-closes:-translate-y-full"]}
                >
                    Contact
                </span>
                <span
                    aria-hidden="true"
                    class:list={[underline, "col-start-1 row-start-1 translate-y-full transition-[background-size,translate] group-data-closes:translate-y-0"]}
                >
                    Close
                </span>
            </button>
        </div>
    </nav>
</header>

<script>
    import { gsap } from "gsap";
    import { prefersReducedMotion } from "../scripts/split";


    const header = document.querySelector<HTMLElement>("[data-nav]")!;
    const panel = header.querySelector<HTMLElement>("[data-nav-panel]")!;
    const about = header.querySelector<HTMLButtonElement>("[data-nav-about]")!;
    const reveals = panel.querySelectorAll("[data-nav-reveal]");
    const canHover = window.matchMedia("(hover: hover) and (pointer: fine)");

    // The panel wipes down while the navbar darkens, and the copy rises in
    // column by column just behind the wipe. Closing plays it back, quicker.
    const tl = gsap
        .timeline({ paused: true })
        .set(panel, { visibility: "visible" }, 0)
        .fromTo(
            panel,
            { clipPath: "inset(0% 0% 100% 0%)" },
            { clipPath: "inset(0% 0% 0% 0%)", duration: 0.7, ease: "expo.out" },
            0,
        )
        .to(header, { color: "#161a1e", duration: 0.3, ease: "power2.out" }, 0.05)
        .fromTo(
            reveals,
            { y: 16, autoAlpha: 0 },
            { y: 0, autoAlpha: 1, duration: 0.6, stagger: 0.06, ease: "power3.out" },
            0.15,
        );

    let open = false;
    const setOpen = (next: boolean) => {
        if (next === open) return;
        open = next;
        header.toggleAttribute("data-about-open", open);
        about.setAttribute("aria-expanded", String(open));
        if (prefersReducedMotion()) tl.progress(open ? 1 : 0).pause();
        else if (open) tl.timeScale(1).play();
        else tl.timeScale(1.6).reverse();
    };

    about.addEventListener("pointerenter", () => canHover.matches && setOpen(true));
    // The panel sits inside the header, so this fires only once the pointer
    // is off both the navbar and the panel
    header.addEventListener("pointerleave", () => canHover.matches && setOpen(false));

    // Heading for Contact closes it: the pointer only has to come within a
    // little of the button, not onto it
    const contact = header.querySelector<HTMLButtonElement>("[data-nav-contact]")!;
    const NEAR = 16;
    header.addEventListener("pointermove", (e) => {
        if (!open || !canHover.matches) return;
        const r = contact.getBoundingClientRect();
        const dx = Math.max(r.left - e.clientX, 0, e.clientX - r.right);
        const dy = Math.max(r.top - e.clientY, 0, e.clientY - r.bottom);
        if (Math.hypot(dx, dy) <= NEAR) setOpen(false);
    });

    // A mouse click keeps it open (hovering already opened it); a tap or a
    // keypress toggles it
    about.addEventListener("click", (e) => {
        setOpen(canHover.matches && e.detail > 0 ? true : !open);
    });

    document.addEventListener("click", (e) => {
        if (open && !header.contains(e.target as Node)) setOpen(false);
    });
    panel.addEventListener("click", (e) => {
        if ((e.target as Element).closest("a")) setOpen(false);
    });
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && open) {
            setOpen(false);
            about.focus();
        }
    });
    header.addEventListener("focusout", (e) => {
        if (!header.contains(e.relatedTarget as Node)) setOpen(false);
    });
</script>
